# Copy to ".env" next to docker-compose.yml and fill in. Never commit .env.
# Generate random values with:  openssl rand -hex 32
# (PowerShell: -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) }))

# --- Public address (HTTPS) ---
# Your domain name, with DNS pointing at this server (ports 80 and 443 open).
# Use "localhost" for a local test (a local certificate, browser warning expected).
DOMAIN=fmcg.example.com
# Let's Encrypt sends certificate expiry notices here.
ACME_EMAIL=it@example.com

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=fmcg_learning
# The backend's own account (full rights on this database only).
MYSQL_APP_USER=fmcg_app
MYSQL_APP_PASSWORD=change-me-app
# Read-only account used by the nightly backup.
MYSQL_BACKUP_USER=fmcg_backup
MYSQL_BACKUP_PASSWORD=change-me-backup

# --- Secrets ---
# Signs sign-in tokens (keep it the same across rebuilds, or everyone is signed out).
FMCG_SECRET_KEY=change-me-to-a-long-random-string
# Shared secret between the backend and the AI service. Required in production.
AI_SERVICE_TOKEN=change-me-to-another-long-random-string

# --- AI ---
# Ollama on this computer (default) or elsewhere
OLLAMA_URL=http://host.docker.internal:11434/api/generate
FMCG_WHISPER_MODEL=small
FMCG_ANALYSIS_WORKERS=1

# --- Limits ---
# Largest recording accepted, in MB.
FMCG_MAX_UPLOAD_MB=500

# --- Backups ---
# Host folder for backups. Use ANOTHER disk or a mounted cloud bucket.
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
# UTC hour of the nightly backup (20 = 01:30 IST)
BACKUP_HOUR=20

# --- Optional overrides (defaults follow DOMAIN) ---
# VITE_API_BASE_URL=https://fmcg.example.com/api
# CORS_ORIGINS=https://fmcg.example.com
# LOG_LEVEL=INFO
