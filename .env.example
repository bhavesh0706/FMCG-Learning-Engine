# Copy to ".env" next to docker-compose.yml and fill in.
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=fmcg_learning
# Any long random string (keeps users signed in across rebuilds)
FMCG_SECRET_KEY=change-me-to-a-long-random-string
# Optional shared secret between backend and AI service
AI_SERVICE_TOKEN=
# Ollama on this computer (default) or elsewhere
OLLAMA_URL=http://host.docker.internal:11434/api/generate
FMCG_WHISPER_MODEL=small
VITE_API_BASE_URL=http://localhost:8000
# Browser origin(s) of the frontend container
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000