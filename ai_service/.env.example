# AI service settings. Copy to ai_service/.env (read at startup) and fill in.
# Real environment variables (PowerShell $env:NAME, PM2 env, Docker) win over this file.
# Restart the AI service after changing anything here.

# --- Which language model answers ---
# true  = local Ollama (OLLAMA_URL + FMCG_LLM_MODEL below)
# false = OpenAI (encrypted key: run python tools/encrypt_openai_key.py)
USE_OLLAMA=true

# --- Ollama (used when USE_OLLAMA=true) ---
OLLAMA_URL=http://127.0.0.1:11434/api/generate
FMCG_LLM_MODEL=qwen2.5:7b

# --- OpenAI (used when USE_OLLAMA=false) ---
# The key is stored ENCRYPTED. Run:  python tools/encrypt_openai_key.py
# It fills OPENAI_API_KEY_ENC below. The master key that unlocks it lives outside
# the project (~/.fmcg/master.key), or set FMCG_MASTER_KEY (Docker/servers) or
# FMCG_MASTER_KEY_FILE. Never put the master key in this file.
OPENAI_API_KEY_ENC=
OPENAI_MODEL=gpt-4o-mini
# Only change for an OpenAI-compatible proxy / Azure-style gateway
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Speech to text (always local) ---
FMCG_WHISPER_MODEL=small

AI_SERVICE_TOKEN=
AI_MAX_CONCURRENT=1
