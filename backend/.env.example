# ============================================================
# Backend settings. Copy to backend/.env and adjust.
# backend/.env is private to each computer/server: never commit it.
# Real environment variables (PowerShell $env:..., Docker) override this file.
# Restart the backend after changing anything here.
# ============================================================

# development | staging | production
APP_ENV=development

# --- Where the API listens (python run.py) ---
# 127.0.0.1 = this computer only. 0.0.0.0 = also reachable from other devices
# on the network (needed for the Flutter app on a real phone).
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Auto-restart on code changes (default: true in development, false otherwise)
BACKEND_RELOAD=true

# --- CORS: the frontend's address(es) in the browser, comma separated ---
# Must match VITE_PORT in frontend/.env.local. localhost and 127.0.0.1 are
# different origins, so keep both. Staging/production: the real site, e.g.
#   CORS_ORIGINS=https://fmcg.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI Model Service (separate process, ai_service/) ---
AI_SERVICE_URL=http://127.0.0.1:8001
# Shared secret; must match AI_SERVICE_TOKEN of the AI service.
# Optional in development, REQUIRED when APP_ENV=production.
AI_SERVICE_TOKEN=

# --- Secrets (fill in on each server; never put these in the frontend) ---
# Signs login tokens. Empty = a random key stored in backend/.secret_key.
FMCG_SECRET_KEY=

# --- Sign-in length (defaults shown) ---
# Survey persons stay signed in this many days, admins this many hours, unless
# the app is used: opening the app renews the sign-in once it is a day old.
# FMCG_TOKEN_DAYS=7
# FMCG_ADMIN_TOKEN_HOURS=24
# FMCG_TOKEN_RENEW_HOURS=24

# --- Activity log (audit trail) ---
# Entries older than this many days are removed (default 1095 = 3 years).
# FMCG_AUDIT_KEEP_DAYS=1095

# --- MySQL ---
# MYSQL_PASSWORD is REQUIRED (there is no password in the code any more).
# The other lines show the defaults; uncomment to change them.
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DATABASE=fmcg_learning
# MYSQL_USER=root
MYSQL_PASSWORD=bhaveshmishra@3109
# Or one full address instead of the lines above (hosting platforms, tests):
# DATABASE_URL=mysql+pymysql://user:password@host:3306/fmcg_learning
# Connection pool (defaults shown)
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE_SECONDS=1800

# --- Uploads and storage ---
# Largest recording accepted, in MB (bigger uploads get HTTP 413).
FMCG_MAX_UPLOAD_MB=500
# Where files are stored (app/services/storage.py). The database stores keys such as
# "videos/1730012345_interview.mp4", never a path on one computer, so the same data works
# on Windows, macOS, Linux and a server, for any user name and project folder.
# Leave these empty to keep the default folders (recordings in <project>/uploads/videos,
# queue and recipe attachments in backend/uploads). Relative paths start at the project folder.
# One base folder for everything (videos, audio, queue, recipe_files are created inside):
# FMCG_STORAGE_ROOT=uploads
# Or set single folders (absolute or relative); these win over FMCG_STORAGE_ROOT:
# FMCG_RECORDINGS_DIR=D:\fmcg\recordings        (Windows)
# FMCG_RECORDINGS_DIR=/Volumes/Data/fmcg/recordings  (macOS)
# FMCG_AUDIO_DIR=
# FMCG_QUEUE_DIR=
# FMCG_ATTACHMENTS_DIR=
# Folders an older setup used, searched for recordings saved before (separate with ;):
# FMCG_LEGACY_STORAGE_ROOTS=D:\old\uploads;/Users/me/old-project/uploads
# Storage type: local (default). An S3-compatible storage can be added for AWS later.
# FMCG_STORAGE_BACKEND=local

# --- Behind a reverse proxy (Caddy/nginx) only ---
# Read the client address from X-Forwarded-For (login throttling). Leave off
# when the API is reached directly, or clients could fake their address.
FMCG_TRUST_PROXY=false

# --- Logs ---
# One JSON line per request on stdout (no tokens or request bodies).
LOG_LEVEL=INFO

# --- Notifications (bell) ---
# Minutes after a survey is submitted before admins are told its video is missing
FMCG_MISSING_VIDEO_MINUTES=10
# Only surveys submitted within this many hours are checked
FMCG_MISSING_VIDEO_LOOKBACK_HOURS=48

# ---- Organization portal and survey rounds ----
# Consumers to survey per round when the organization doesn't say (default 30).
# FMCG_ROUND_TARGET=30
# Shown on the organization's Account page as its contact (default: "your ione account manager").
# FMCG_ORG_CONTACT=Anuj, ione account manager
