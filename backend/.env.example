# ============================================================
# Backend settings. Copy to backend/.env and adjust.
# backend/.env is private to each computer/server: never commit it.
# Real environment variables (PowerShell $env:..., Docker) override this file.
# Restart the backend after changing anything here.
# ============================================================

# development | staging | production
APP_ENV=development

# --- Where the API listens (python run.py) ---
# 127.0.0.1 = this computer only. 0.0.0.0 = also reachable from other devices
# on the network (needed for the Flutter app on a real phone).
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Auto-restart on code changes (default: true in development, false otherwise)
BACKEND_RELOAD=true

# --- CORS: the frontend's address(es) in the browser, comma separated ---
# Must match VITE_PORT in frontend/.env.local. localhost and 127.0.0.1 are
# different origins, so keep both. Staging/production: the real site, e.g.
#   CORS_ORIGINS=https://fmcg.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI Model Service (separate process, ai_service/) ---
AI_SERVICE_URL=http://127.0.0.1:8001
# Shared secret; must match AI_SERVICE_TOKEN of the AI service.
# Optional in development, REQUIRED when APP_ENV=production.
AI_SERVICE_TOKEN=

# --- Secrets (fill in on each server; never put these in the frontend) ---
# Signs login tokens. Empty = a random key stored in backend/.secret_key.
FMCG_SECRET_KEY=

# --- MySQL ---
# MYSQL_PASSWORD is REQUIRED (there is no password in the code any more).
# Put the real password ONLY in backend/.env, never in this file.
# The other lines show the defaults; uncomment to change them.
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DATABASE=fmcg_learning
# MYSQL_USER=root
MYSQL_PASSWORD=
# Or one full address instead of the lines above (hosting platforms, tests):
# DATABASE_URL=mysql+pymysql://user:password@host:3306/fmcg_learning
# Connection pool (defaults shown)
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE_SECONDS=1800

# --- Uploads and storage ---
# Largest recording accepted, in MB (bigger uploads get HTTP 413).
FMCG_MAX_UPLOAD_MB=500
# Where recordings and the analysis queue are stored (defaults: uploads/videos
# next to backend/, and backend/uploads/queue).
# FMCG_RECORDINGS_DIR=D:\fmcg\recordings
# FMCG_QUEUE_DIR=D:\fmcg\queue

# --- Behind a reverse proxy (Caddy/nginx) only ---
# Read the client address from X-Forwarded-For (login throttling). Leave off
# when the API is reached directly, or clients could fake their address.
FMCG_TRUST_PROXY=false

# --- Logs ---
# One JSON line per request on stdout (no tokens or request bodies).
LOG_LEVEL=INFO

# --- Notifications (bell) ---
# Minutes after a survey is submitted before admins are told its video is missing
FMCG_MISSING_VIDEO_MINUTES=10
# Only surveys submitted within this many hours are checked
FMCG_MISSING_VIDEO_LOOKBACK_HOURS=48